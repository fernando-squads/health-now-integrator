# Copy to .env and fill in your authorized environment settings.
# The application does not load .env automatically. In bash/zsh, load it before Java:
# set -a
# source .env
# set +a
# Never commit .env or real credentials.

# Private S3 destination. Replace the bucket and prefix with authorized values.
AWS_REGION=sa-east-1
AWS_BUCKET=
INTEGRATOR_S3_PREFIX=loads

# Optional environment credentials for the official AWS SDK.
# Leave these unset when using an AWS profile or workload role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# Optional password for opt-in local PostgreSQL integration tests only.
# The Swing application receives database credentials through its connection form.
# ESUS_PASSWORD=

# Extraction settings are Java system properties, not environment variables.
# Example JVM arguments (before -jar):
# -Dintegrator.installation=your-installation-id
# source_version is read automatically from tb_config_sistema (VERSAOBANCODADOS).
# -Dintegrator.output=exports
# -Dintegrator.cutoff=2026-10-08
# -Dintegrator.pageSize=1000
# -Dintegrator.timeoutSeconds=30

# API file registration is not yet implemented by health-now-api.
# No notification URL or API credential variable is currently consumed.
